# Telegram Bot API token issued by BotFather.
BOT_TOKEN=your-telegram-bot-token

# Supabase project URL (e.g. https://xxxxxxxx.supabase.co).
SUPABASE_URL=https://your-project.supabase.co

# Supabase service/anon key with insert rights on bot_account_logs.
SUPABASE_KEY=your-supabase-key

# Master switch for the credential relay flow (delete + inbox + reply).
# "true" enables it; anything else (or unset) keeps it DISABLED so the bot
# only passively collects users into telegram_users_qll.
RELAY_ENABLED=false

# OPTIONAL: project Supabase KHÁC chứa bảng checkin_logs (điểm danh VHHS).
# Dùng cho lệnh /checkin (đọc CTV đã check-in thực tế theo ca). Thiếu một trong
# hai biến -> tính năng check-in tắt (bot vẫn chạy bình thường).
CHECKIN_SUPABASE_URL=https://your-checkin-project.supabase.co
CHECKIN_SUPABASE_KEY=your-checkin-supabase-key

# OPTIONAL: Bee AI (Groq) - nói chuyện tự nhiên thay vì gõ lệnh /.
# Mặc định TẮT. Chỉ bật khi AI_ENABLED=true VÀ có GROQ_API_KEY.
AI_ENABLED=false
GROQ_API_KEY=your-groq-api-key
# Model (mặc định openai/gpt-oss-20b), trần lượt AI mỗi ngày (mặc định 300, tối đa 900)
# và username bot (mặc định vh_messenger_bot) - có thể bỏ trống.
GROQ_MODEL=
AI_DAILY_CAP=
BOT_USERNAME=
# Tùy chọn Bee AI (có mặc định, không cần đặt):
# GROQ_AGENT_MODEL=openai/gpt-oss-120b   # model trò chuyện với admin
# GROQ_MAX_COMPLETION_TOKENS=300         # trần output mỗi lần gọi (100-800)
# GROQ_TIMEOUT=5000                      # ms mỗi lần gọi (1000-8000)
