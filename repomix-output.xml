    );

    // Admin (sender) + An + Bình are collected; the bot member is skipped.
    const ids = upsert.mock.calls.map((c) => (c[0] as { telegram_id: number }).telegram_id);
    expect(ids.sort()).toEqual([500, 601, 602]);
