    await handleUpdate(textDm(ADMIN_ID, "/OK"), deps);

    expect(sendQueueInsert).toHaveBeenCalledTimes(1);
    const enqueued = sendQueueInsert.mock.calls[0][0] as {
      send_after: string | null;
