    expect(await deletePendingBatch(client, ADMIN_ID)).toEqual({ ok: true });
    expect(from).toHaveBeenCalledWith("pending_batches");
    expect(eq).toHaveBeenCalledWith("admin_id", ADMIN_ID);
  });

  it("returns { ok: false } on error", async () => {
