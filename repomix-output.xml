    expect(enqueued).toHaveLength(1);
    expect(enqueued[0].send_after).toBeNull();
    expect(sendMessage).toHaveBeenCalledWith(
      ADMIN_ID,
      "✅ Đã xếp 1 tin vào hàng đợi. Bot sẽ gửi rải ~15-20s/tin, sẽ báo lại khi xong."
    );
  });

  it("/ok groups students sharing a QLL into one row with a single @tag", async () => {
    const items: MappedItem[] = [
      {
        tenHS: "HS Một",
        maLop: "KHTN.2026.0001",
        ngayHoc: "15/10/2026",
        lichHoc: "T5 20:30-21:30",
        username: "SA_X",
      },
      {
        tenHS: "HS Hai",
        maLop: "TOAN.2026.0002",
        ngayHoc: "16/10/2026",
        lichHoc: "",
        username: "SA_X",
      },
      {
        tenHS: "HS Ba",
        maLop: "MOET.2026.0003",
        ngayHoc: "17/10/2026",
        lichHoc: "T6",
        username: "SA_Y",
      },
